---
const links = [
	{ href: '#platform', label: 'Platform' },
	{ href: '#pipeline', label: 'Pipeline' },
	{ href: '#deployments', label: 'Deployments' },
	{ href: '#pricing', label: 'Pricing' },
	{ href: '#faq', label: 'FAQ' },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur-md">
	<nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8" aria-label="Main">
		<a href="#top" class="flex items-center gap-2.5">
			<span
				class="flex h-7 w-7 items-center justify-center rounded-md bg-ink font-serif text-sm text-paper"
				aria-hidden="true">™</span
			>
			<span class="text-[15px] font-semibold tracking-tight">Satire-as-a-Service<span class="align-super text-[9px]">™</span></span>
		</a>

		<div class="hidden items-center gap-7 md:flex">
			{links.map((link) => (
				<a href={link.href} class="text-sm text-muted transition-colors hover:text-ink">{link.label}</a>
			))}
		</div>

		<div class="flex items-center gap-3">
			<a
				href="#cta"
				class="hidden rounded-lg bg-ink px-4 py-2 text-sm font-medium text-paper transition-colors hover:bg-accent sm:block"
				>Request a demo</a
			>
			<button
				id="nav-toggle"
				type="button"
				class="flex h-9 w-9 items-center justify-center rounded-md border border-line md:hidden"
				aria-expanded="false"
				aria-controls="nav-mobile"
				aria-label="Toggle navigation"
			>
				<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M1 3.5h14M1 8h14M1 12.5h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
				</svg>
			</button>
		</div>
	</nav>

	<div id="nav-mobile" class="hidden border-t border-line px-5 pt-2 pb-4 md:hidden">
		{links.map((link) => (
			<a href={link.href} class="block py-2.5 text-sm text-muted hover:text-ink">{link.label}</a>
		))}
		<a href="#cta" class="mt-2 block rounded-lg bg-ink px-4 py-2.5 text-center text-sm font-medium text-paper">Request a demo</a>
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const panel = document.getElementById('nav-mobile');
	if (toggle && panel) {
		toggle.addEventListener('click', () => {
			const open = panel.classList.toggle('hidden');
			toggle.setAttribute('aria-expanded', String(!open));
		});
		panel.addEventListener('click', (event) => {
			if (event.target instanceof HTMLAnchorElement) {
				panel.classList.add('hidden');
				toggle.setAttribute('aria-expanded', 'false');
			}
		});
	}
</script>

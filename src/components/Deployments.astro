---
const cases = [
	{
		id: 'SAAS-0002',
		brand: 'Endless Buzzwords™',
		category: 'Content operations',
		input: '“Tech brands post constantly without ever having a new idea.”',
		pattern: 'Publishing cadence decoupled from insight production.',
		line: 'Priced for volume, not originality.',
	},
	{
		id: 'SAAS-0003',
		brand: 'Legacy-as-a-Service™',
		category: 'Infrastructure preservation',
		input: '“We keep deferring the migration. Forever.”',
		pattern: 'Institutionalized decision not to fix anything.',
		line: 'Scale your technical debt with confidence.',
	},
	{
		id: 'SAAS-0004',
		brand: 'ContextMaxxing™',
		category: 'Context infrastructure',
		input: '“Everyone insists the AI just needs more context.”',
		pattern: 'Judgment outsourced one document at a time.',
		line: 'More context. Fewer questions. Less you.',
	},
];
---

<section id="deployments" class="border-b border-line">
	<div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
		<div class="max-w-2xl" data-reveal>
			<p class="font-mono text-[11px] font-medium tracking-[0.22em] text-accent uppercase">Deployments</p>
			<h2 class="mt-4 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
				Real grievances. Real <span class="accent-word">products</span>.
			</h2>
			<p class="mt-5 text-lg leading-relaxed text-muted">
				Every deployment begins as a single human frustration. The platform handles the rest —
				positioning, features, metrics, and a landing page with complete confidence in itself.
			</p>
		</div>

		<div class="mt-14 grid gap-5 lg:grid-cols-3">
			{cases.map((c) => (
				<article class="flex flex-col rounded-xl border border-line bg-surface" data-reveal>
					<div class="flex items-center justify-between border-b border-line px-6 py-3.5">
						<span class="font-mono text-[11px] tracking-[0.14em] text-faint">{c.id}</span>
						<span class="flex items-center gap-2 font-mono text-[11px] text-muted">
							<span class="h-1.5 w-1.5 rounded-full bg-emerald-600" aria-hidden="true"></span> Deployed
						</span>
					</div>
					<div class="flex flex-1 flex-col px-6 py-6">
						<p class="font-mono text-[11px] tracking-[0.14em] text-faint uppercase">Grievance</p>
						<p class="mt-1.5 font-mono text-[13px] leading-relaxed text-muted">{c.input}</p>
						<p class="mt-5 font-mono text-[11px] tracking-[0.14em] text-faint uppercase">Pattern</p>
						<p class="mt-1.5 text-[14px] leading-relaxed text-muted">{c.pattern}</p>
						<p class="mt-5 font-mono text-[11px] tracking-[0.14em] text-faint uppercase">Generated product</p>
						<h3 class="mt-1.5 text-lg font-semibold tracking-tight">{c.brand}</h3>
						<p class="text-sm text-muted">{c.category}</p>
						<p class="accent-word mt-auto pt-6 text-lg leading-snug text-ink">“{c.line}”</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

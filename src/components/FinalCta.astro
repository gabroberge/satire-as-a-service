<section id="cta" class="bg-night text-paper">
	<div class="mx-auto max-w-6xl px-5 py-24 text-center sm:px-8 sm:py-32">
		<div class="mx-auto max-w-2xl" data-reveal>
			<h2 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
				Your frustration is currently <span class="accent-word">unmonetized</span>.
			</h2>
			<p class="mt-6 text-lg leading-relaxed text-night-muted">
				Turn your next complaint into a category. The pipeline is already running.
			</p>
			<div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
				<a
					href="#top"
					class="w-full rounded-lg bg-paper px-7 py-3 text-sm font-medium text-ink transition-colors hover:bg-white sm:w-auto"
					>Submit a grievance</a
				>
				<a
					href="#pricing"
					class="w-full rounded-lg border border-night-line px-7 py-3 text-sm font-medium text-paper transition-colors hover:border-paper sm:w-auto"
					>Talk to sales</a
				>
			</div>
			<p class="mt-5 font-mono text-xs text-night-muted/70">
				No demo required. The demo is the company.
			</p>
		</div>
	</div>
</section>

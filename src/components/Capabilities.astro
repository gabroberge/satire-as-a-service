---
const brandPairs = [
	{ from: 'technical debt', to: 'Legacy-as-a-Service™' },
	{ from: 'thought leadership spam', to: 'Endless Buzzwords™' },
	{ from: 'AI context obsession', to: 'ContextMaxxing™' },
	{ from: 'unclear ownership', to: 'Ownership-as-a-Service™' },
];

const featurePairs = [
	{ from: 'Meetings', to: 'Alignment Continuity™' },
	{ from: 'Nobody decides', to: 'Distributed Ownership™' },
	{ from: 'Ignoring documentation', to: 'Documentation Independence™' },
	{ from: 'Guessing', to: 'Predictive Intent Resolution™' },
];

const gradient = ['Useful', 'Convenient', 'Questionable', 'Organizationally horrifying'];
---

<section id="platform" class="border-b border-line">
	<div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
		<div class="max-w-2xl" data-reveal>
			<p class="font-mono text-[11px] font-medium tracking-[0.22em] text-accent uppercase">Platform</p>
			<h2 class="mt-4 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
				Everything required to run satire in <span class="accent-word">production</span>.
			</h2>
		</div>

		<div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
			<!-- Grievance Ingestion -->
			<article class="flex flex-col rounded-xl border border-line bg-surface p-6" data-reveal>
				<h3 class="text-base font-semibold tracking-tight">Grievance Ingestion™</h3>
				<p class="mt-2 text-[15px] leading-relaxed text-muted">
					Paste what annoys you. Structured or emotional — the intake layer accepts both. Supported
					formats include Slack rants, meeting transcripts, exit interviews, and sighs (transcribed).
				</p>
				<div class="mt-5 rounded-lg border border-line bg-paper px-4 py-3.5 font-mono text-xs leading-relaxed">
					<p class="text-faint">OBSERVED FRUSTRATION</p>
					<p class="mt-1">“Developers keep adding abstractions nobody needs.”</p>
					<p class="mt-3 text-faint">UNDERLYING PATTERN</p>
					<p class="mt-1">Complexity used as a proxy for engineering maturity.</p>
					<p class="mt-3 text-faint">SATIRICAL OPPORTUNITY</p>
					<p class="mt-1 font-medium text-accent">HIGH</p>
				</div>
			</article>

			<!-- Brandification Engine -->
			<article class="flex flex-col rounded-xl border border-line bg-surface p-6" data-reveal>
				<h3 class="text-base font-semibold tracking-tight">Brandification Engine™</h3>
				<p class="mt-2 text-[15px] leading-relaxed text-muted">
					Every dysfunction deserves a category leader. The engine converts ordinary organizational
					failure into venture-backable terminology.
				</p>
				<dl class="mt-5 space-y-2.5 rounded-lg border border-line bg-paper px-4 py-3.5 font-mono text-xs leading-relaxed">
					{brandPairs.map((pair) => (
						<div class="flex items-baseline justify-between gap-3">
							<dt class="text-muted">{pair.from}</dt>
							<dd class="text-right font-medium">{pair.to}</dd>
						</div>
					))}
				</dl>
			</article>

			<!-- Feature Synthesis -->
			<article class="flex flex-col rounded-xl border border-line bg-surface p-6" data-reveal>
				<h3 class="text-base font-semibold tracking-tight">Feature Synthesis™</h3>
				<p class="mt-2 text-[15px] leading-relaxed text-muted">
					Converts organizational problems into trademarked capabilities at a sustained ratio of 14
					features per dysfunction.
				</p>
				<dl class="mt-5 space-y-2.5 rounded-lg border border-line bg-paper px-4 py-3.5 font-mono text-xs leading-relaxed">
					{featurePairs.map((pair) => (
						<div class="flex items-baseline justify-between gap-3">
							<dt class="text-muted">{pair.from}</dt>
							<dd class="text-right font-medium">{pair.to}</dd>
						</div>
					))}
				</dl>
			</article>

			<!-- Dystopia Gradient -->
			<article class="flex flex-col rounded-xl border border-line bg-surface p-6" data-reveal>
				<h3 class="text-base font-semibold tracking-tight">Dystopia Gradient™</h3>
				<p class="mt-2 text-[15px] leading-relaxed text-muted">
					Automated narrative pacing for generated products. The premise is revealed gradually, section
					by section. Never waste a good dystopia in the hero.
				</p>
				<ol class="mt-5 space-y-1.5 rounded-lg border border-line bg-paper px-4 py-3.5 font-mono text-xs leading-relaxed">
					{gradient.map((step, i) => (
						<li class="flex items-center gap-2.5">
							<span class="text-faint">{i > 0 ? '↓' : ' '}</span>
							<span class={i === gradient.length - 1 ? 'font-medium text-accent' : ''}>{step}</span>
						</li>
					))}
				</ol>
			</article>

			<!-- Executive Metric Fabrication -->
			<article class="flex flex-col rounded-xl border border-line bg-surface p-6" data-reveal>
				<h3 class="text-base font-semibold tracking-tight">Executive Metric Fabrication™</h3>
				<p class="mt-2 text-[15px] leading-relaxed text-muted">
					Generates evidence that impresses stakeholders without asserting anything anyone could
					meaningfully verify.
				</p>
				<dl class="mt-5 space-y-2.5 rounded-lg border border-line bg-paper px-4 py-3.5 font-mono text-xs leading-relaxed">
					<div class="flex items-baseline justify-between gap-3">
						<dt class="text-muted">Satirical throughput</dt>
						<dd class="font-medium text-emerald-700">↑ 418%</dd>
					</div>
					<div class="flex items-baseline justify-between gap-3">
						<dt class="text-muted">Stakeholder amusement</dt>
						<dd class="font-medium">94%</dd>
					</div>
					<div class="flex items-baseline justify-between gap-3">
						<dt class="text-muted">Methodology</dt>
						<dd class="font-medium">—</dd>
					</div>
				</dl>
			</article>

			<!-- Recursive Satire -->
			<article class="flex flex-col rounded-xl border border-line bg-surface p-6" data-reveal>
				<h3 class="text-base font-semibold tracking-tight">Recursive Satire™</h3>
				<p class="mt-2 text-[15px] leading-relaxed text-muted">
					Point the platform at its own output. Satire about satire, generated and monitored to
					arbitrary depth.
				</p>
				<dl class="mt-5 space-y-2.5 rounded-lg border border-line bg-paper px-4 py-3.5 font-mono text-xs leading-relaxed">
					<div class="flex items-baseline justify-between gap-3">
						<dt class="text-muted">Recursion depth</dt>
						<dd class="font-medium">4</dd>
					</div>
					<div class="flex items-baseline justify-between gap-3">
						<dt class="text-muted">SaaS products generated</dt>
						<dd class="font-medium">17</dd>
					</div>
					<div class="flex items-baseline justify-between gap-3">
						<dt class="text-muted">Original thoughts</dt>
						<dd class="font-medium">1</dd>
					</div>
					<div class="mt-1 border-t border-line pt-2.5 text-[11px] text-faint">
						Recursion stable. Original premise still detectable.
					</div>
				</dl>
			</article>
		</div>
	</div>
</section>

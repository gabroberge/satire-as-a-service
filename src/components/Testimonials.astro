---
const testimonials = [
	{
		quote: 'We used to complain about our engineering culture in Slack. Now those complaints have positioning.',
		name: 'VP of Engineering',
		org: 'Series C infrastructure company',
	},
	{
		quote: 'Procurement approved the invoice before realizing the product was about procurement.',
		name: 'Chief of Staff',
		org: 'Enterprise software vendor',
	},
	{
		quote: 'Our organizational dysfunction finally has a landing page.',
		name: 'CTO',
		org: 'Undisclosed logistics platform',
	},
];
---

<section class="border-b border-line bg-surface">
	<div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
		<div class="grid gap-10 md:grid-cols-3 md:gap-8">
			{testimonials.map((t) => (
				<figure class="flex flex-col border-t border-line pt-6" data-reveal>
					<blockquote class="accent-word text-xl leading-snug text-balance sm:text-[1.35rem]">
						“{t.quote}”
					</blockquote>
					<figcaption class="mt-auto pt-6 text-sm">
						<span class="font-medium">{t.name}</span>
						<span class="text-muted"> · {t.org}</span>
					</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>
